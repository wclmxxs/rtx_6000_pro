ARG CUDA_VERSION=13.0.3

FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu24.04 AS builder

ARG COMFYUI_COMMIT=c2bcbecd82ec5ae66594340b395c24ef0217b238
ARG TURBO_NODE_COMMIT=4274783a23afcfdbea3b4876cb79effd6c510785
ARG SAGEATTENTION_COMMIT=eb615cf6cf4d221338033340ee2de1c37fbdba4a
ARG CACHEDIT_COMFY_COMMIT=1d92bbd86ec59aa6223fe2368849b7413a1acb93
ARG CACHEDIT_VERSION=1.2.0

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_CUDA_ARCH_LIST=12.0a \
    MAX_JOBS=8

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 python3-dev python3-venv python3-pip git git-lfs \
       build-essential ninja-build ffmpeg curl ca-certificates \
       libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip setuptools wheel \
    && /opt/venv/bin/pip install \
       --index-url https://download.pytorch.org/whl/cu130 \
       torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0

RUN git clone --filter=blob:none https://github.com/comfyanonymous/ComfyUI.git /opt/ComfyUI \
    && git -C /opt/ComfyUI checkout --detach "${COMFYUI_COMMIT}" \
    && /opt/venv/bin/pip install -r /opt/ComfyUI/requirements.txt \
    && /opt/venv/bin/pip install 'comfy-kitchen[cublas]==0.2.30' hf_xet

RUN git clone https://github.com/Larryvrh/ComfyUI-MiniMax-H3-Turbo.git \
      /opt/ComfyUI/custom_nodes/ComfyUI-MiniMax-H3-Turbo \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI-MiniMax-H3-Turbo \
      checkout --detach "${TURBO_NODE_COMMIT}"

RUN git clone https://github.com/thu-ml/SageAttention.git /src/SageAttention \
    && git -C /src/SageAttention checkout --detach "${SAGEATTENTION_COMMIT}" \
    && test "$(git -C /src/SageAttention rev-parse HEAD)" = "${SAGEATTENTION_COMMIT}" \
    && mkdir -p /wheels \
    && /opt/venv/bin/pip wheel \
       --no-build-isolation --no-deps --wheel-dir /wheels /src/SageAttention \
    && /opt/venv/bin/pip install --no-deps /wheels/sageattention-2.2.0-*.whl

RUN git clone https://github.com/Jasonzzt/ComfyUI-CacheDiT.git \
      /opt/ComfyUI/custom_nodes/ComfyUI-CacheDiT \
    && git -C /opt/ComfyUI/custom_nodes/ComfyUI-CacheDiT \
      checkout --detach "${CACHEDIT_COMFY_COMMIT}" \
    && test "$(git -C /opt/ComfyUI/custom_nodes/ComfyUI-CacheDiT rev-parse HEAD)" \
      = "${CACHEDIT_COMFY_COMMIT}" \
    && /opt/venv/bin/pip install "cache-dit==${CACHEDIT_VERSION}"

FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/opt/venv/bin:${PATH} \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       python3 ffmpeg curl ca-certificates libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/ComfyUI /opt/ComfyUI

WORKDIR /opt/ComfyUI
EXPOSE 8188
